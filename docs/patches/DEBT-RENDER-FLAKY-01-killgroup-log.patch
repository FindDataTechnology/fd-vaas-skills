 function killGroup(pid, sig) {
   if (!pid) return;
+  // ── 诊断日志（只观测，不改语义）────────────────────────────────────────
+  // 背景：DEBT-RENDER-FLAKY-01 —— 20s storyboard 走 API 间歇 500，job 目录里留下
