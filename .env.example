# VAAS 项目配置示例
# 复制到 .env(会被 git ignore,存实际值)
#
#   cp .env.example .env
#   $EDITOR .env
#
# .env 是唯一的、项目根级、所有 skill 共享的配置文件。
# 按需要每支视频微调 → downloads/fd-videos/<slug>/.publish.env(格式一样,只写要覆盖的项)。
# 优先级:CLI --flag > <task>/.publish.env > <VAAS>/.env > 内置默认。

# ═══════════════════════════════════════════════════════════
# 火山方舟 · fd-vaas-video-creator 内置生成器 (TTS / Seedream / Seedance)（多 Provider via LiteLLM bridge）
# ═══════════════════════════════════════════════════════════
model=doubao-seed-1-6-250615
vol_agent_api_key=YOUR_ARK_KEY_HERE
vol_base_url=https://ark.cn-beijing.volces.com

# ═══════════════════════════════════════════════════════════
# fd-vaas-publish · 社交平台分发
# ═══════════════════════════════════════════════════════════

# ─── 平台开关 ────────────────────────────────────────
# 逗号分隔,发到哪些平台。可选:douyin, xiaohongshu, bilibili, kuaishou, tencent, youtube
PLATFORMS=douyin,xiaohongshu

# ─── 登录态(ego-browser 继承用户 Chrome 登录态,无需 account/cookie) ─
# 每个平台登一次,ego-browser 会复用 Chrome 的登录 session:
#   ego-browser 打开平台登录页 -> 扫码 -> 登录态自动持久化

# ─── 全局默认(每个平台如未单独覆盖就用这个) ────────
# 标签,英文逗号分隔,不要 # 号,别用空格
TAGS=开源,AI,数据

# 直发还是定时?SCHEDULE 留空 = 立即;格式 "YYYY-MM-DD HH:MM" 例 2026-07-20 21:30
SCHEDULE=

# 无头模式(true/false),抖音/视频号首次登录改 false 手动扫码
HEADLESS=true

# ─── 平台差异化偏好(可覆盖全局) ─────────────────────

# 抖音:一般讲长文案在 desc,tag 6-10 个内最佳
DOUYIN_DESC_MAX=1000
DOUYIN_TAGS=开源,AI,数据,MCP,量化

# 小红书:用 note 字段(不叫 desc),笔记体,末尾话题标签
XIAOHONGSHU_TAGS=开源工具,AI效率,数据分析,程序员日常

# B站分区 tid(预留;skill 路径暂不自动选分区,若以后支持会读这个)。常见:36=科技·软件应用 122=科技·数码 124=知识·科学科普 208=知识·财经商业
BILIBILI_TID=36
BILIBILI_TAGS=开源,AI,数据,MCP

# 视频号:短标题 ≤ 6 字
TENCENT_SHORT_TITLE=开源上新

# YouTube:visibility=public|unlisted|private
YOUTUBE_VISIBILITY=unlisted
YOUTUBE_TAGS=opensource,AI,data,MCP

# ═══════════════════════════════════════════════════════════
# fd-vaas-publish-docs · 图文/文章分发(知乎/公众号/小红书/雪球/东财/同花顺)
# ═══════════════════════════════════════════════════════════
# 浏览器自动化走 ego-browser(继承 Chrome 登录态,无 cookie 文件)。
# 文章源:downloads/fd-docs/<slug>/article.md + meta.json。详见 .claude/skills/fd-vaas-publish-docs/SKILL.md

# ─── 平台开关 ────────────────────────────────────────
# 逗号分隔。可选:zhihu,weixin,xiaohongshu,xueqiu,eastmoney,tonghuashun
PLATFORMS_DOCS=zhihu,weixin,xiaohongshu

# ─── 全局默认标签(英文逗号分隔,不要 # 号) ──────────
DOC_TAGS=开源,AI,数据

# 定时:"YYYY-MM-DD HH:MM",留空=立即发(公众号默认存草稿)
DOC_SCHEDULE=

# 无头模式(true/false),首次登录改 false 好扫码
DOC_HEADLESS=true

# ─── 平台差异化标签(_DOC_TAGS 后缀,和视频 skill 的 *_TAGS 区分) ──
# 知乎:话题 ≤5 个
ZHIHU_DOC_TAGS=开源,AI,数据,量化

# 公众号:无标签概念(用合集),这里留空;摘要必填(publish.mjs 自动生成)
WEIXIN_DOC_TAGS=

# 小红书:笔记体话题 ≤10,中文短语推荐率高;图文必须至少 1 张图
XIAOHONGSHU_DOC_TAGS=开源工具,AI效率,数据分析,程序员日常

# 雪球:可加 $股票代码 关联个股
XUEQIU_DOC_TAGS=开源,AI,数据,量化

# 东方财富号:需先开通财经号
EASTMONEY_DOC_TAGS=开源,AI,数据

# 同花顺财经号:需先开通财经号
TONGHUASHUN_DOC_TAGS=开源,AI,数据
