# VAAS 项目配置示例
# 复制到 .env(会被 git ignore,存实际值)
#
#   cp .env.example .env
#   $EDITOR .env
#
# .env 是唯一的、项目根级、所有 skill 共享的配置文件。
# 按需要每支视频微调 → downloads/fd-videos/<slug>/.publish.env(格式一样,只写要覆盖的项)。
# 优先级:CLI --flag > <task>/.publish.env > <VAAS>/.env > 内置默认。

# ═══════════════════════════════════════════════════════════
# 火山方舟 · byted-ark-tts-skill / byted-ark-seedance-skill / byted-ark-seedream-skill
# ═══════════════════════════════════════════════════════════
model=doubao-seed-1-6-250615
vol_agent_api_key=YOUR_ARK_KEY_HERE
vol_base_url=https://ark.cn-beijing.volces.com

# ═══════════════════════════════════════════════════════════
# fd-vaas-publish · 社交平台分发
# ═══════════════════════════════════════════════════════════

# ─── 平台开关 ────────────────────────────────────────
# 逗号分隔,发到哪些平台。可选:douyin, xiaohongshu, bilibili, kuaishou, tencent, youtube
PLATFORMS=douyin,xiaohongshu

# ─── 各平台的 account_name(见 social-auto-upload/cookies/<platform>_uploader/) ─
DOUYIN_ACCOUNT=main
XIAOHONGSHU_ACCOUNT=main
BILIBILI_ACCOUNT=main
KUAISHOU_ACCOUNT=main
TENCENT_ACCOUNT=main
YOUTUBE_ACCOUNT=main

# ─── 全局默认(每个平台如未单独覆盖就用这个) ────────
# 标签,英文逗号分隔,不要 # 号,别用空格
TAGS=开源,AI,数据

# 直发还是定时?SCHEDULE 留空 = 立即;格式 "YYYY-MM-DD HH:MM" 例 2026-07-20 21:30
SCHEDULE=

# 无头模式(true/false),抖音/视频号首次登录改 false 手动扫码
HEADLESS=true

# ─── 平台差异化偏好(可覆盖全局) ─────────────────────

# 抖音:一般讲长文案在 desc,tag 6-10 个内最佳
DOUYIN_DESC_MAX=1000
DOUYIN_TAGS=开源,AI,数据,MCP,量化

# 小红书:用 note 字段(不叫 desc),笔记体,末尾话题标签
XIAOHONGSHU_TAGS=开源工具,AI效率,数据分析,程序员日常

# B站:必须给 tid(分区 id)。常见:36=科技·软件应用 122=科技·数码 124=知识·科学科普 208=知识·财经商业
BILIBILI_TID=36
BILIBILI_TAGS=开源,AI,数据,MCP

# 视频号:短标题 ≤ 6 字
TENCENT_SHORT_TITLE=开源上新

# YouTube:visibility=public|unlisted|private
YOUTUBE_VISIBILITY=unlisted
YOUTUBE_TAGS=opensource,AI,data,MCP

# ─── social-auto-upload 项目路径 ─────────────────────
SAU_PROJECT_DIR=/Users/chengsishi/VAAS/social-auto-upload
