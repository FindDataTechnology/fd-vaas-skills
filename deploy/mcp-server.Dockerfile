# VAAS generation-plane MCP server (hosted mode). CANONICAL — the repo-root
# ./Dockerfile is a generated byte-copy of this file (build-pool convention
# builds ./Dockerfile); regenerate with `bash scripts/gen-root-dockerfile.sh`
# and keep them in sync (the drift check in scripts/ci-local.sh / CI enforces).
# Publish-plane tools and Remotion(node) are intentionally NOT in this image
# (workspace ADR-0004): the hosted surface is generate/render/assets/templates/registry.
#
# The server runs from the SOURCE TREE (/app/mcp-server) rather than a wheel:
# utils/db paths resolve VAAS_ROOT by walking up package-relative parents, so
# the /app layout (mcp-server/, scripts/, data/, downloads/) must match the
# repo checkout. PYTHONPATH keeps that true inside the image.
#
# RENDER BASE (deliver-hosted-surface): the hosted surface advertises
# render_still/render_document/render_video(type=html)/voiceover — those run
# on headless chromium + ffmpeg + CJK fonts. The base ships WITH them so the
# advertised capability is real (presentation-plane「渲染底座统一」).
# Image size grows ~+500MB (chromium+fonts+ffmpeg): check the deploy node
# disk headroom before rolling (see deploy/README 存活与恢复).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/mcp-server

# ── Rendering base: ffmpeg (concat/mix/duration probes) + CJK fonts (no tofu)
# + chromium (headless scenes) as system deps. apt layer cached separately.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg fonts-noto-cjk fontconfig \
        chromium \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Font cache for the CJK stacks chromium picks up
RUN fc-cache -f || true

COPY mcp-server/ /app/mcp-server/
COPY scripts/ /app/scripts/

# Video-type registry metadata (type.json listing for templates_list) — the
# node/Remotion runtime itself stays out per ADR-0004; type MODE runs the
# python HTML builder path (same local behavior).
COPY .agents/skills/fd-vaas-video-creator/types/ /app/.agents/skills/fd-vaas-video-creator/types/

# Python deps: server deps + playwright (python API) + mutagen (mp3 duration).
# The render plane resolves chromium itself: VAAS_CHROMIUM_EXECUTABLE pins it,
# else system /usr/bin/chromium wins (offline-friendly, no download needed).
RUN pip install --no-cache-dir "fastmcp>=3,<4" "pydantic>=2" aiosqlite python-dotenv \
        markdown "mutagen>=1.47" \
        "playwright>=1.49"

# Runtime layout (volumes):
#   /app/data/vaas.db        — material store (owner-scoped)
#   /app/downloads/          — generated artifacts (GC-managed)
# Bootstrap env (set at deploy, never baked):
#   VAAS_HOSTED=1, VAAS_LINE, VAAS_PORT, VAAS_BIND, VAAS_BEARER_TOKEN,
#   OPENBAO_ADDR, OPENBAO_TOKEN, VAAS_PRICING_FILE, VAAS_PUBLIC_URL.
EXPOSE 30950
CMD ["python3", "-m", "mcp_server.main"]
