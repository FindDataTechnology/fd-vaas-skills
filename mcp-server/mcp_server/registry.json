{
  "voice": [
    { "name": "tts", "provider": "volcengine", "model": "${TTS_MODEL}", "driver": "generate_voice" }
  ],
  "image": [
    { "name": "seedream", "provider": "volcengine", "model": "${IMAGE_MODEL}", "driver": "generate_image" }
  ],
  "video": [
    { "name": "seedance", "provider": "volcengine", "model": "${VIDEO_MODEL}", "driver": "generate_video" },
    { "name": "voiceover", "provider": "local", "model": "remotion", "driver": "create_voiceover" }
  ],
  "cover": [
    { "name": "brand", "provider": "local", "model": "remotion", "driver": "create_cover" }
  ],
  "chart": [
    { "name": "echarts", "provider": "local", "model": "chromium", "driver": "render_chart" }
  ],
  "doc": [
    { "name": "chromium", "provider": "local", "model": "print", "driver": "render_document" }
  ]
}
